# Copy this file to .env.local and fill in real values.
# .env* is gitignored — never commit real secrets.

# ── Supabase (same project as Leo Billing — see supabase/migrations) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never import
# outside src/lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://www.anniescakes.example

# ── Admin API (product photo upload from Leo Billing) ──
# Firebase project whose ID tokens are accepted as owner credentials.
FIREBASE_PROJECT_ID=
# Comma-separated Firebase UIDs allowed to manage product photos.
# Fails closed: if this is empty, the admin API rejects everything.
OWNER_FIREBASE_UIDS=
# Comma-separated origins allowed to call the admin API.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# ── Business info (centralized in src/lib/site-config.ts) ──
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_ADDRESS_LINE1=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_STATE=
NEXT_PUBLIC_ADDRESS_PINCODE=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ── Analytics (optional, added in Phase 13) ──
# NEXT_PUBLIC_ANALYTICS_ID=

# ── Email notifications (Gmail SMTP) ──
# Google App Password (Security -> 2-Step Verification -> App passwords).
# Never the account password.
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=


# ── Telegram order bot (optional) ────────────────────────────
# Leave TELEGRAM_BOT_TOKEN empty to disable the bot entirely.
#
# 1. Create the bot with @BotFather, copy the token here.
# 2. Generate a webhook secret:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Deploy, then run: node scripts/telegram-setup.mjs
# 4. Message the bot /id and put the number in TELEGRAM_ALLOWED_CHAT_IDS.
#
# Only the chat IDs listed here can use the bot. An empty list means the
# bot answers nobody — it fails closed on purpose.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# Link target for the bot's "Make bill" button (your Leo Billing URL).
LEO_BILLING_URL=

# Firebase UID of the business_profiles row this website bills as.
# Must name ONE profile explicitly: the Supabase project is shared
# with other businesses, and this decides whose UPI ID customers pay.
BUSINESS_PROFILE_UID=
